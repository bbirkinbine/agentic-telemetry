# Value-free template for the agent's .env (untracked), next to compose.yaml on
# the inference host:
#   cp env.example .env
# Real addresses come from the vault's ENDPOINTS.md and stay in .env.

# OTLP/HTTP endpoint of the telemetry stack's Collector. While the stack runs on
# the Mac, the Mac's current LAN address (for example http://192.0.2.20:4318).
# Not its mDNS .local name: the agent's static Go resolver cannot resolve one,
# even where the host can. Spec 0006 repoints it to the telemetry VM.
TELEMETRY_OTLP_ENDPOINT=http://telemetry.example:4318

# Disk-backed sending queue. Create it and chown it to 10001:10001 (the image's user).
AGENT_QUEUE_DIR=/var/lib/agentic-telemetry/queue

# Directory holding targets.json (format: targets.example.json). Never put the
# example itself here: every *.json in this directory is scraped.
AGENT_TARGETS_DIR=/etc/agentic-telemetry/targets
