# Value-free template for collector/.env (untracked). Copy it, then set real values:
#   cp env.example .env
# Real hostnames and addresses come from the vault's ENDPOINTS.md and stay in .env.

# Data root on this host. On the Mac it must sit under a path OrbStack shares.
# Create its subdirectories with the steps in README.md -> Run locally on the Mac.
TELEMETRY_ROOT=/srv/telemetry

# host:port of the llama-swap gateway's /metrics, scraped by the Collector.
LLAMA_SWAP_TARGET=gpu.example:9292

# Address every published port binds to. On the Mac: 0.0.0.0 on the home network,
# so the inference host agent can reach the Collector (spec 0007), and 127.0.0.1
# anywhere else. On the telemetry VM, its LAN or Tailnet address (for example
# 192.0.2.10).
TELEMETRY_BIND_ADDR=127.0.0.1
